# ── Database ────────────────────────────────────────────────────────────────
# On Railway, set this as a REFERENCE to the database service so traffic stays
# on the private network:
#   DATABASE_URL = ${{ Postgres.DATABASE_URL }}
# (replace "Postgres" with your database service's name — the dashboard has an
# autocomplete dropdown). For local runs, paste the Postgres service's
# DATABASE_PUBLIC_URL instead.
DATABASE_URL=postgres://postgres:password@postgres.railway.internal:5432/railway

# ── GitHub ──────────────────────────────────────────────────────────────────
# Personal access token (classic, no scopes needed for public repos).
# Without a token you get 60 requests/hour; with one, 5000/hour.
GITHUB_TOKEN=

# Sources — use one or all three.

# 1 = all PUBLIC repos of the token's own account via /user/repos (owned +
# collaborator + accessible org repos). Requires GITHUB_TOKEN below.
GITHUB_SOURCE_SELF=0

# Comma-separated GitHub org/user logins. Their repos are listed via
# /users/{owner}/repos with pagination (no result cap).
GITHUB_OWNERS=vercel,facebook

# Search queries — one per line. GitHub caps search at 1000 results per query,
# so use tight qualifiers if you need broad coverage.
GITHUB_SEARCH_QUERIES=stars:>50000 language:TypeScript

# Sliced search — one broad query per line. Must contain a created:>=DATE or
# created:A..B bound; the runner automatically splits the date range so every
# slice stays under GitHub's 1000-result cap. Built for large sweeps like:
# GITHUB_SLICED_SEARCH=created:>=2022-01-01 stars:>=100

# ── Filters / behavior ──────────────────────────────────────────────────────
INCLUDE_FORKS=0
# Archived repos keep getting snapshots so their history stays continuous.
INCLUDE_ARCHIVED=1
# OFF by default: adds true watchers (subscribers) via 1 extra API call per
# repo (~5,000 repos/hour on a token). Only worth it for small sets.
FETCH_DETAILS=0
# 1 = no DB needed; just lists what WOULD be upserted. Great for testing config.
DRY_RUN=0

# ── Web mode (optional, MODE=web) ───────────────────────────────────────────
MODE=cron
# Bearer token required by POST /run in web mode. Leave empty only for testing.
RUN_TOKEN=
